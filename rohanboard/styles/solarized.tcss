/*
 * Solarized-ish theme for rohanboard.
 * Adjusts the App's primary/accent palette and re-skins panels.
 */

App {
    background: #002b36;
    color: #93a1a1;
}

Screen {
    background: #002b36;
}

Header {
    background: #073642;
    color: #93a1a1;
}

Header HeaderTitle {
    color: #b58900;
    text-style: bold;
}

Footer {
    background: #073642;
    color: #93a1a1;
}

Tabs {
    background: #002b36;
}

Tab {
    color: #586e75;
}
Tab.-active {
    color: #b58900;
    text-style: bold;
}

TabbedContent {
    height: 1fr;
}

.tab-body {
    height: 1fr;
}

DataTable {
    background: #002b36;
    color: #93a1a1;
}
DataTable > .datatable--header {
    text-style: bold;
    color: #b58900;
    background: #073642;
}
DataTable > .datatable--cursor {
    background: #586e75;
    color: #fdf6e3;
}

StoragePanel,
NodesTable,
JobsTable,
NodesSummary {
    border: round #b58900;
}

StoragePanel > .title,
NodesTable > .title,
JobsTable > .title,
NodesSummary > .title {
    color: #b58900;
}

StorageBar Bar > .bar--bar {
    color: #859900;   /* solarized green */
}
StorageBar.bar-warning Bar > .bar--bar  { color: #b58900; }   /* yellow */
StorageBar.bar-critical Bar > .bar--bar { color: #dc322f; }   /* red */
